{
  "name": "@fuego0/configs",
  "version": "1.0.1",
  "description": "ESLint Flat Config and Prettier presets for TypeScript, React, and Node.",
  "type": "module",
  "license": "MIT",
  "author": "Fuego",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fuego-Zero/configs.git"
  },
  "bugs": {
    "url": "https://github.com/Fuego-Zero/configs/issues"
  },
  "homepage": "https://github.com/Fuego-Zero/configs#readme",
  "keywords": [
    "eslint",
    "eslint-config",
    "prettier",
    "typescript",
    "react",
    "flat-config"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": "./src/index.js",
    "./eslint": "./src/eslint/index.js",
    "./eslint/base": "./src/eslint/base.js",
    "./eslint/react": "./src/eslint/react.js",
    "./eslint/node": "./src/eslint/node.js",
    "./react": "./src/eslint/react.js",
    "./node": "./src/eslint/node.js",
    "./prettier": "./src/prettier.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "eslint src eslint.config.js prettier.config.js --cache",
    "lint:fix": "eslint src eslint.config.js prettier.config.js --fix --cache",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "npm run test:validation && npm run test:fix",
    "test:validation": "node ./tests/run-validation.mjs",
    "test:fix": "node ./tests/run-fix.mjs",
    "test:acceptance": "node ./tests/run-acceptance.mjs",
    "verify": "npm test && npm run lint && npm run format:check && npm run test:acceptance",
    "pack:check": "npm pack --dry-run",
    "benchmark:lint": "node ./tests/benchmark-lint.mjs"
  },
  "peerDependencies": {
    "eslint": ">=10.4.0 <11",
    "prettier": ">=3.0.0 <4",
    "typescript": ">=5.0.0 <6.1.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-perfectionist": "^5.11.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-jsx": "5.20.4",
    "eslint-plugin-react-x": "5.20.4",
    "eslint-plugin-unicorn": "^76.0.0",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.70.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "react": "^19.3.0",
    "typescript": "~5.9.3"
  }
}
